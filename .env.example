# FloodWatch local/deployment environment template
# Copy to .env and fill private values locally. Never commit the resulting .env.
# Blank provider fields keep optional integrations disabled.

# Required by docker-compose.yml
FLOODWATCH_MYSQL_DATABASE=floodwatch
FLOODWATCH_MYSQL_USER=floodwatch_app
FLOODWATCH_MYSQL_PASSWORD=
FLOODWATCH_MYSQL_ROOT_PASSWORD=

# API/security
FLOOD_EWS_INGEST_TOKEN=
FLOOD_EWS_SECURE_COOKIES=0

# External news (optional)
FLOOD_EWS_NEWS_PROVIDER=off
FLOOD_EWS_NEWSAPI_KEY=
FLOOD_EWS_GNEWS_API_KEY=
FLOOD_EWS_RSS_FEEDS=
FLOOD_EWS_NEWS_QUERY=flood OR rainfall Nigeria
FLOOD_EWS_NEWS_LANGUAGE=en
FLOOD_EWS_NEWS_COUNTRY=

# Contact form / EmailJS (optional)
FLOODWATCH_CONTACT_EMAIL=
FLOOD_EWS_EMAILJS_PUBLIC_KEY=
FLOOD_EWS_EMAILJS_SERVICE_ID=
FLOOD_EWS_EMAILJS_CONTACT_TEMPLATE_ID=

# Flood-alert email / EmailJS (optional)
FLOOD_EWS_EMAILJS_ALERT_TEMPLATE_ID=
FLOOD_EWS_EMAILJS_PRIVATE_KEY=
FLOOD_EWS_ALERT_EMAIL_TO=

# Flood-alert SMS / Twilio (optional)
FLOOD_EWS_TWILIO_ACCOUNT_SID=
FLOOD_EWS_TWILIO_AUTH_TOKEN=
# Preferred neutral sender key. For Nigeria, check current sender-registration rules.
FLOOD_EWS_TWILIO_SENDER=
# Legacy fallback only; leave blank when FLOOD_EWS_TWILIO_SENDER is used.
FLOOD_EWS_TWILIO_FROM_NUMBER=
FLOOD_EWS_ALERT_SMS_TO=
